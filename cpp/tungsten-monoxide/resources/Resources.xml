	<Namespace name="Tracks">	
		<Resource type="Shader" name="TrackVertexShader" location="shaders/track.vert" />

		<Resource type="Shader" name="TrackFragmentShader" location="shaders/track.frag">
			<Definitions>
				<Definition>
					<textures>1</textures>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Program" name="TrackProgram">
			<DependentResources>
				<DependentResource id="Vertex" ref="TrackVertexShader" />
				<DependentResource id="Fragment" ref="TrackFragmentShader" />
			</DependentResources>

			<Definitions>
				<Definition>
					<!-- attribs:
					- textures: if >0, 'textures' is set (defaults to 0)
					- colours: if true, 'colours' is set (defaults to false)
					- diffuse: if true, 'diffuse' is set (defaults to false)
					-->
					<Attribs>
						<textures>1</textures>
						<!-- <diffuse>true</diffuse> -->
					</Attribs>
					
					<MeshSpecification>
						<primitive>triangles</primitive>
						<indexed>false</indexed>
						<storage>dynamic</storage>
						
						<Buffers>
							<Buffer>
								<Channels>
									<Channel>
										<data>position3</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>normal3</data>
										<type>float32</type>
									</Channel>
								</Channels>
							</Buffer>
							<Buffer>
								<Channels>
									<Channel>
										<data>texcoord2</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>colour4</data>
										<type>uint8</type>
										<normalised>true</normalised>
									</Channel>
								</Channels>
							</Buffer>
						</Buffers>
					</MeshSpecification>
				</Definition>
			</Definitions>
		</Resource>
		
