	<Resource type="Image" name="Floor5" location="images/floor5.png" />

	<Resource type="Image" name="Floor6" location="images/floor6.png" />
	
	<!--
	Maps
	-->
	<Namespace name="World">	
		<Resource type="Shader" name="WorldVertexShader" location="shaders/world.vert" />

		<Resource type="Shader" name="WorldFragmentShader" location="shaders/world.frag">
			<Definitions>
				<Definition>
					<textures>1</textures>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Program" name="WorldProgram">
			<DependentResources>
				<DependentResource id="Vertex" ref="WorldVertexShader" />
				<DependentResource id="Fragment" ref="WorldFragmentShader" />
			</DependentResources>

			<Definitions>
				<Definition>
					<!-- attribs:
					- textures: if >0, 'textures' is set (defaults to 0)
					- colours: if true, 'colours' is set (defaults to false)
					- diffuse: if true, 'diffuse' is set (defaults to false)
					-->
					<Attribs>
						<textures>1</textures>
						<!-- <diffuse>true</diffuse> -->
					</Attribs>
					
					<MeshSpecification>
						<primitive>triangles</primitive>
						<indexed>false</indexed>
						<storage>dynamic</storage>
						
						<Buffers>
							<Buffer>
								<Channels>
									<Channel>
										<data>position3</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>normal3</data>
										<type>float32</type>
									</Channel>
								</Channels>
							</Buffer>
							<Buffer>
								<Channels>
									<Channel>
										<data>texcoord2</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>colour4</data>
										<type>uint8</type>
										<normalised>true</normalised>
									</Channel>
								</Channels>
							</Buffer>
						</Buffers>
					</MeshSpecification>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Material" name="Material.Default">
			<DependentResources>
				<DependentResource id="Program" ref="WorldProgram" />
				<DependentResource id="Texture" ref="/Floor5" />
			</DependentResources>

			<Definitions>
				<Definition>
					<Textures>
						<Texture sampler="TEX1" type="resource">Texture</Texture>
					</Textures>
				</Definition>
			</Definitions>
		</Resource>

		<Resource type="TextFile" name="WorldFile" location="gen-2.yaml" />

		<Resource type="Map" name="World">
			<DependentResources>
				<DependentResource id="Yaml" ref="WorldFile" />
			</DependentResources>
			<Definitions>
				<Definition factory="BooleanWorld">
					<Resource>Yaml</Resource>
				</Definition>
			</Definitions>
		</Resource>
	</Namespace>    
</Resources>