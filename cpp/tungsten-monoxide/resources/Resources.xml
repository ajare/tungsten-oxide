<?xml version="1.0"?>
<Resources>
    <Resource type="Game" name="TungstenMonoxide">
        <DependentResources>
            <DependentResource id="ShipMaterial" ref="ShipPbrMaterial"/>
        </DependentResources>
        <Definitions>
            <Definition>
                <ShipModel>
                    <ModelFile>box.mppmodel</ModelFile>
                    <Material>Ship.Surface</Material>
                </ShipModel>
            </Definition>
        </Definitions>
    </Resource>
    <Resource type="PbrMaterialBinding" name="ShipPbrMaterial">
        <Definitions>
            <Definition><Binding>Ship.Surface</Binding></Definition>
        </Definitions>
    </Resource>
    <!--
    Maps. editorTrackMaterial/editorMaterialKey/editorTexture are editor-only authoring metadata;
    the runtime factory reads Binding and ignores the additional attributes.
    -->
    <Namespace name="Tracks">
        <Resource type="PbrMaterialBinding" name="TrackAsphaltMaterial"
                  editorTrackMaterial="AsphaltTrack"
                  editorMaterialKey="Tracks/TrackAsphaltMaterial"
                  editorTexture="../pbr/textures/asphalt.png">
            <Definitions><Definition><Binding>Track.Asphalt</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultTrackChoice"
                  editorTrackMaterial="DefaultTrack"
                  editorMaterialKey="Tracks/TrackAsphaltMaterial"
                  editorTexture="../pbr/textures/asphalt.png">
            <Definitions><Definition><Binding>Track.Asphalt</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultRailMaterial"
                  editorMaterialKey="Tracks/DefaultRailMaterial">
            <Definitions><Definition><Binding>Track.Rail</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultMeshMaterial"
                  editorMaterialKey="Tracks/DefaultMeshMaterial">
            <Definitions><Definition><Binding>Track.Mesh</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultShellMaterial"
                  editorMaterialKey="Tracks/DefaultShellMaterial">
            <Definitions><Definition><Binding>Track.Shell</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultZoneMaterial"
                  editorMaterialKey="Tracks/DefaultZoneMaterial">
            <Definitions><Definition><Binding>Track.Zone</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="DefaultTriggerMaterial"
                  editorMaterialKey="Tracks/DefaultTriggerMaterial">
            <Definitions><Definition><Binding>Track.Trigger</Binding></Definition></Definitions>
        </Resource>
        <Resource type="PbrMaterialBinding" name="ModelTool.DefaultFallbackMaterial3D"
                  editorMaterialKey="ModelTool.DefaultFallbackMaterial3D">
            <Definitions><Definition><Binding>Track.Fallback</Binding></Definition></Definitions>
        </Resource>
        <Resource type="Track" name="NewTrack">
            <DependentResources>
                <DependentResource id="Tracks/TrackAsphaltMaterial" ref="Tracks/TrackAsphaltMaterial"/>
                <DependentResource id="Tracks/DefaultRailMaterial" ref="Tracks/DefaultRailMaterial"/>
                <DependentResource id="Tracks/DefaultMeshMaterial" ref="Tracks/DefaultMeshMaterial"/>
                <DependentResource id="Tracks/DefaultShellMaterial" ref="Tracks/DefaultShellMaterial"/>
                <DependentResource id="Tracks/DefaultZoneMaterial" ref="Tracks/DefaultZoneMaterial"/>
                <DependentResource id="Tracks/DefaultTriggerMaterial" ref="Tracks/DefaultTriggerMaterial"/>
                <DependentResource id="ModelTool.DefaultFallbackMaterial3D" ref="Tracks/ModelTool.DefaultFallbackMaterial3D"/>
            </DependentResources>
            <Definitions>
                <Definition factory="Track">
                    <Models>
                        <Model id="NewTrack">
                            <ModelFile>NewTrack.mppmodel</ModelFile>
                            <TrackData>NewTrack.json</TrackData>
                            <Meshes>
                                <Mesh>
                                    <Name>path-0-surface</Name>
                                    <Type>Track</Type>
                                    <Visible>true</Visible>
                                </Mesh>
                                <Mesh>
                                    <Name>path-0-rail-left</Name>
                                    <Type>Track</Type>
                                    <Visible>true</Visible>
                                </Mesh>
                                <Mesh>
                                    <Name>path-0-rail-right</Name>
                                    <Type>Track</Type>
                                    <Visible>true</Visible>
                                </Mesh>
                            </Meshes>
                        </Model>
                        <Model id="model1">
                            <ModelFile>box.mppmodel</ModelFile>
                            <Meshes>
                                <Mesh>
                                    <Name>Mesh</Name>
                                    <Type>Physical</Type>
                                    <Visible>true</Visible>
                                </Mesh>
                            </Meshes>
                        </Model>
                    </Models>
                </Definition>
            </Definitions>
        </Resource>
    </Namespace>
</Resources>
