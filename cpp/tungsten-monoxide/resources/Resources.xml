<?xml version="1.0"?>
<Resources>

	<Resource type="Game" name="TungstenMonoxide">
		<DependentResources />
		
		<Definitions>
			<Definition />
		</Definitions>
	</Resource>
	
	<!--
	Maps
	-->
	<Namespace name="Tracks">	
		<Resource type="Shader" name="TrackVertexShader" location="shaders/track.vert" />

		<Resource type="Shader" name="TrackFragmentShader" location="shaders/track.frag">
			<Definitions>
				<Definition>
					<textures>1</textures>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Program" name="TrackProgram">
			<DependentResources>
				<DependentResource id="Vertex" ref="TrackVertexShader" />
				<DependentResource id="Fragment" ref="TrackFragmentShader" />
			</DependentResources>

			<Definitions>
				<Definition>
					<!-- attribs:
					- textures: if >0, 'textures' is set (defaults to 0)
					- colours: if true, 'colours' is set (defaults to false)
					- diffuse: if true, 'diffuse' is set (defaults to false)
					-->
					<Attribs>
						<textures>1</textures>
						<!-- <diffuse>true</diffuse> -->
					</Attribs>
					
					<MeshSpecification>
						<primitive>triangles</primitive>
						<indexed>false</indexed>
						<storage>dynamic</storage>
						
						<Buffers>
							<Buffer>
								<Channels>
									<Channel>
										<data>position3</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>normal3</data>
										<type>float32</type>
									</Channel>
								</Channels>
							</Buffer>
							<Buffer>
								<Channels>
									<Channel>
										<data>texcoord2</data>
										<type>float32</type>
									</Channel>
									<Channel>
										<data>colour4</data>
										<type>uint8</type>
										<normalised>true</normalised>
									</Channel>
								</Channels>
							</Buffer>
						</Buffers>
					</MeshSpecification>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Image" name="DefaultRailTexture" location="images/test.png" />
		<Resource type="Image" name="DefaultMeshTexture" location="images/test.png" />
		<Resource type="Image" name="DefaultTrackTexture" location="images/test.png" />
		<Resource type="Image" name="TrackTexture" location="images/floor5.png" />

		<Resource type="Material" name="DefaultRailMaterial">
			<DependentResources>
				<DependentResource id="Program" ref="TrackProgram" />
				<DependentResource id="Texture" ref="DefaultRailTexture" />
			</DependentResources>

			<Definitions>
				<Definition>
					<Textures>
						<Texture type="resource" sampler="TEX1">Texture</Texture>
					</Textures>
				</Definition>
			</Definitions>
		</Resource>

		<Resource type="Material" name="DefaultMeshMaterial">
			<DependentResources>
				<DependentResource id="Program" ref="TrackProgram" />
				<DependentResource id="Texture" ref="DefaultMeshTexture" />
			</DependentResources>

			<Definitions>
				<Definition>
					<Textures>
						<Texture type="resource" sampler="TEX1">Texture</Texture>
					</Textures>
				</Definition>
			</Definitions>
		</Resource>
		
		<Resource type="Material" name="DefaultTrackMaterial">
			<DependentResources>
				<DependentResource id="Program" ref="TrackProgram" />
				<DependentResource id="Texture" ref="DefaultTrackTexture" />
			</DependentResources>

			<Definitions>
				<Definition>
					<Textures>
						<Texture type="resource" sampler="TEX1">Texture</Texture>
					</Textures>
				</Definition>
			</Definitions>
		</Resource>

		<Resource type="Material" name="TrackAsphaltMaterial">
			<DependentResources>
				<DependentResource id="Program" ref="TrackProgram" />
				<DependentResource id="Texture" ref="TrackTexture" />
			</DependentResources>

			<Definitions>
				<Definition>
					<Textures>
						<Texture type="resource" sampler="TEX1">Texture</Texture>
					</Textures>
				</Definition>
			</Definitions>
		</Resource>

		<Resource type="TrackMaterial" name="DefaultTrack">
			<DependentResources>
				<DependentResource id="Material" ref="DefaultTrackMaterial" />
			</DependentResources>

			<Definitions>
				<Definition />
			</Definitions>
		</Resource>
		
		<Resource type="TrackMaterial" name="AlphaltTrack">
			<DependentResources>
				<DependentResource id="Material" ref="TrackAsphaltMaterial" />
			</DependentResources>

			<Definitions>
				<Definition />
			</Definitions>
		</Resource>
		
		<Resource type="Track" name="NewTrack">
			<DependentResources>
				<DependentResource id="Tracks/AlphaltTrack" ref="Tracks/AlphaltTrack" />
				<DependentResource id="Tracks/DefaultRailMaterial" ref="Tracks/DefaultRailMaterial" />
				<DependentResource id="Tracks/DefaultMeshMaterial" ref="Tracks/DefaultMeshMaterial" />
			</DependentResources>
			<Definitions>
				<Definition factory="Track">
					<File>NewTrack.mppmodel</File>
				</Definition>
			</Definitions>
		</Resource>

	</Namespace>
</Resources>