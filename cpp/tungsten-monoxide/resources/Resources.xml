<?xml version="1.0"?>
<Resources>
    <Resource type="Game" name="TungstenMonoxide">
        <DependentResources>
            <DependentResource id="ShipMaterial" ref="Texture"/>
        </DependentResources>
        <Definitions>
            <Definition>
                <ShipModel>
                    <ModelFile>box.mppmodel</ModelFile>
                    <Material>Texture</Material>
                </ShipModel>
            </Definition>
        </Definitions>
    </Resource>
    <Resource type="Image" name="BoxTexture" location="images/CesiumLogoFlat.png"/>
    <Resource type="Material" name="Texture">
        <DependentResources>
            <DependentResource id="Program" ref="Tracks/TrackProgram"/>
            <DependentResource id="Texture" ref="BoxTexture"/>
        </DependentResources>
        <Definitions>
            <Definition>
                <Textures>
                    <Texture type="resource" sampler="TEX1">Texture</Texture>
                </Textures>
            </Definition>
        </Definitions>
    </Resource>
    <!--
	Maps
	-->
    <Namespace name="Tracks">
        <Resource type="Shader" name="TrackVertexShader" location="shaders/track.vert"/>
        <Resource type="Shader" name="TrackFragmentShader" location="shaders/track.frag">
            <Definitions>
                <Definition>
                    <textures>1</textures>
                </Definition>
            </Definitions>
        </Resource>
        <Resource type="Program" name="TrackProgram">
            <DependentResources>
                <DependentResource id="Vertex" ref="TrackVertexShader"/>
                <DependentResource id="Fragment" ref="TrackFragmentShader"/>
            </DependentResources>
            <Definitions>
                <Definition>
                    <!-- attribs:
					- textures: if >0, 'textures' is set (defaults to 0)
					- colours: if true, 'colours' is set (defaults to false)
					- diffuse: if true, 'diffuse' is set (defaults to false)
					-->
                    <Attribs>
                        <textures>1</textures>
                        <!-- <diffuse>true</diffuse> -->
                    </Attribs>
                    <MeshSpecification>
                        <primitive>triangles</primitive>
                        <indexed>false</indexed>
                        <storage>dynamic</storage>
                        <Buffers>
                            <Buffer>
                                <Channels>
                                    <Channel>
                                        <data>position3</data>
                                        <type>float32</type>
                                    </Channel>
                                    <Channel>
                                        <data>normal3</data>
                                        <type>float32</type>
                                    </Channel>
                                </Channels>
                            </Buffer>
                            <Buffer>
                                <Channels>
                                    <Channel>
                                        <data>texcoord2</data>
                                        <type>float32</type>
                                    </Channel>
                                    <Channel>
                                        <data>colour4</data>
                                        <type>uint8</type>
                                        <normalised>true</normalised>
                                    </Channel>
                                </Channels>
                            </Buffer>
                        </Buffers>
                    </MeshSpecification>
                </Definition>
            </Definitions>
        </Resource>
        <Resource type="Image" name="DefaultRailTexture" location="images/test.png"/>
        <Resource type="Image" name="DefaultMeshTexture" location="images/test.png"/>
        <Resource type="Image" name="DefaultShellTexture" location="images/test.png"/>
        <Resource type="Image" name="DefaultZoneTexture" location="images/test.png"/>
        <Resource type="Image" name="DefaultTriggerTexture" location="images/test.png"/>
        <Resource type="Image" name="DefaultTrackTexture" location="images/test.png"/>
        <Resource type="Image" name="TrackTexture" location="images/floor5.png"/>
        <Resource type="Material" name="DefaultRailMaterial">
            <DependentResources>
