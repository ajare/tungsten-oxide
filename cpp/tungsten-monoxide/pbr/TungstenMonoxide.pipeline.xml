  <Imports>
    <Import><id>shadowDepth</id><semantic>shadowDepth</semantic><format>DEPTH24</format><usage>depthAttachment,sampled</usage><required>true</required></Import>
    <Import><id>screen</id><semantic>presentation</semantic><format>RGBA8</format><usage>colourAttachment,presentation</usage><required>true</required></Import>
  </Imports>
  <Outputs>
    <Output><name>Main</name><image>Presentation</image><taaDepth>SceneDepth</taaDepth><AntiAliasing><msaa>off</msaa><ssaa>off</ssaa><taa>false</taa><fxaa>false</fxaa></AntiAliasing></Output>
  </Outputs>
  <Environment><binding>TungstenMonoxide.Environment</binding></Environment>
  <Bloom><enabled>false</enabled><blurPasses>0</blurPasses></Bloom>
  <PreviewBindings>
    <Material><binding>Ship.Surface</binding><resource>Ship.Surface</resource></Material>
    <Material><binding>Track.Asphalt</binding><resource>Track.Asphalt</resource></Material>
    <Material><binding>Track.Rail</binding><resource>Track.Rail</resource></Material>
    <Material><binding>Track.Mesh</binding><resource>Track.Mesh</resource></Material>
