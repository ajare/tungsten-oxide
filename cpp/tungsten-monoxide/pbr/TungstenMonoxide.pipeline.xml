  <RenderGraph>
    <Images>
      <Image><name>ShadowDepth</name><format>DEPTH24</format><usage>depthAttachment,sampled</usage><import>shadowDepth</import><external>true</external><transient>false</transient></Image>
      <Image><name>SceneHdr</name><format>RGBA16F</format><usage>colourAttachment,sampled</usage><colourSpace>LINEAR</colourSpace><minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter><wrap>CLAMP_TO_EDGE</wrap></Image>
      <Image><name>SceneDepth</name><format>DEPTH24</format><usage>depthAttachment,sampled</usage></Image>
      <Image><name>Presentation</name><format>RGBA8</format><usage>sampled,colourAttachment,presentation</usage><import>screen</import><external>true</external><transient>false</transient></Image>
    </Images>
    <Passes>
      <Pass><name>ShadowDepth</name><type>scene</type><factory>MPP.ShadowDepth</factory><Depth><image>ShadowDepth</image><load>clear</load><store>store</store><clear>1</clear></Depth></Pass>
      <Pass><name>PbrScene</name><type>scene</type><factory>MPP.PbrScene</factory><Inputs><Sampled><sampler>SHADOW_MAP</sampler><image>ShadowDepth</image></Sampled></Inputs><Colours><Output><image>SceneHdr</image><load>clear</load><store>store</store><clear>0.008 0.012 0.02 1</clear></Output></Colours><Depth><image>SceneDepth</image><load>clear</load><store>store</store><clear>1</clear></Depth></Pass>
      <Pass><name>ToneMapPresentation</name><type>present</type><factory>MPP.ToneMapPresent</factory><Inputs><Sampled><sampler>TEX1</sampler><image>SceneHdr</image></Sampled></Inputs><Parameters><Float><name>EXPOSURE</name><value>1</value></Float><Int><name>TONE_MAP_OPERATOR</name><value>1</value></Int></Parameters><Colours><Output><image>Presentation</image><load>clear</load><store>store</store><clear>0 0 0 1</clear></Output></Colours></Pass>
    </Passes>
  </RenderGraph>
</PbrPipeline>
