<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture pipeline for cpp/model-io's tests. Deliberately not TungstenMonoxide.pipeline.xml: these
  tests assert on exact layouts and material names, and coupling them to the game's authored
  pipeline would make an ordinary art change break the test suite.

  Two materials, chosen to cover both halves of the contract:
    Test.Indexed     indexed, 52 bytes, with tangent4  (the Ship.Surface shape)
    Test.Flat        non-indexed, 36 bytes, no tangent4 (the Track.* shape)
-->
<PbrPipeline>
  <version>1</version>
  <name>ModelIo.Test</name>
  <LocalResources>
    <PbrMaterial>
      <name>Test.Indexed</name>
      <MeshSpecification>
        <primitive>triangles</primitive><indexed>true</indexed><storage>static</storage>
        <Buffer>
          <Channel><data>position3</data><type>float32</type></Channel>
          <Channel><data>normal3</data><type>float32</type></Channel>
          <Channel><data>texcoord2</data><type>float32</type></Channel>
          <Channel><data>colour4</data><type>uint8</type><normalised>true</normalised></Channel>
          <Channel><data>tangent4</data><type>float32</type></Channel>
        </Buffer>
      </MeshSpecification>
      <Surface>
        <baseColourFactor>1 1 1 1</baseColourFactor>
        <metallicFactor>0.15</metallicFactor><roughnessFactor>0.55</roughnessFactor>
        <emissiveFactor>0 0 0</emissiveFactor>
        <normalScale>1</normalScale><occlusionStrength>1</occlusionStrength>
        <alphaMode>OPAQUE</alphaMode><alphaCutoff>0.5</alphaCutoff><doubleSided>false</doubleSided>
      </Surface>
    </PbrMaterial>
    <PbrMaterial>
      <name>Test.Flat</name>
      <MeshSpecification>
        <primitive>triangles</primitive><indexed>false</indexed><storage>static</storage>
        <Buffer>
          <Channel><data>position3</data><type>float32</type></Channel>
          <Channel><data>normal3</data><type>float32</type></Channel>
          <Channel><data>texcoord2</data><type>float32</type></Channel>
          <Channel><data>colour4</data><type>uint8</type><normalised>true</normalised></Channel>
        </Buffer>
      </MeshSpecification>
      <Surface>
        <baseColourFactor>1 1 1 1</baseColourFactor>
        <metallicFactor>0</metallicFactor><roughnessFactor>0.78</roughnessFactor>
        <emissiveFactor>0 0 0</emissiveFactor>
        <normalScale>1</normalScale><occlusionStrength>1</occlusionStrength>
        <alphaMode>OPAQUE</alphaMode><alphaCutoff>0.5</alphaCutoff><doubleSided>false</doubleSided>
      </Surface>
    </PbrMaterial>
  </LocalResources>
  <Imports>
    <Import><id>screen</id><semantic>presentation</semantic><format>RGBA8</format><usage>colourAttachment,presentation</usage><required>true</required></Import>
  </Imports>
  <Outputs>
    <Output><name>Main</name><image>Presentation</image><taaDepth>SceneDepth</taaDepth><AntiAliasing><msaa>off</msaa><ssaa>off</ssaa><taa>false</taa><fxaa>false</fxaa></AntiAliasing></Output>
  </Outputs>
  <Environment><binding>Test.Environment</binding></Environment>
  <Bloom><enabled>false</enabled><blurPasses>0</blurPasses></Bloom>
  <RenderGraph>
    <Images>
      <Image><name>SceneHdr</name><format>RGBA16F</format><usage>colourAttachment,sampled</usage><colourSpace>LINEAR</colourSpace><minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter><wrap>CLAMP_TO_EDGE</wrap></Image>
      <Image><name>SceneDepth</name><format>DEPTH24</format><usage>depthAttachment,sampled</usage></Image>
      <Image><name>Presentation</name><format>RGBA8</format><usage>sampled,colourAttachment,presentation</usage><import>screen</import><external>true</external><transient>false</transient></Image>
    </Images>
    <Passes>
      <Pass><name>PbrScene</name><type>scene</type><factory>MPP.PbrScene</factory><Colours><Output><image>SceneHdr</image><load>clear</load><store>store</store><clear>0 0 0 1</clear></Output></Colours><Depth><image>SceneDepth</image><load>clear</load><store>store</store><clear>1</clear></Depth></Pass>
      <Pass><name>ToneMapPresentation</name><type>present</type><factory>MPP.ToneMapPresent</factory><Inputs><Sampled><sampler>TEX1</sampler><image>SceneHdr</image></Sampled></Inputs><Parameters><Float><name>EXPOSURE</name><value>1</value></Float><Int><name>TONE_MAP_OPERATOR</name><value>1</value></Int></Parameters><Colours><Output><image>Presentation</image><load>clear</load><store>store</store><clear>0 0 0 1</clear></Output></Colours></Pass>
    </Passes>
  </RenderGraph>
</PbrPipeline>
